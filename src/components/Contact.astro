---
import { site, socialLinks } from '../data/site';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow"><span class="idx">05</span> / Contact</p>
    <h2 id="contact-title">Got a pipeline problem<br /> or a procedural idea?</h2>
    <a class="email" href={`mailto:${site.email}`}>
      {site.email} <span class="arrow" aria-hidden="true">↗</span>
    </a>
    <div class="row">
      <ul class="links">
        {
          socialLinks.map((link) => (
            <li>
              <a class="btn btn-ghost" href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="location mono">Based in {site.location}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: radial-gradient(70% 60% at 15% 100%, rgba(228, 87, 15, 0.07), transparent 70%);
  }

  .idx {
    color: var(--text-dim);
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 7vw, 5rem);
    letter-spacing: -0.04em;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 2.4rem);
    font-weight: 500;
    color: var(--accent-text);
    border-bottom: 1px solid rgba(228, 87, 15, 0.35);
    padding-bottom: 0.2rem;
    overflow-wrap: anywhere;
    transition: border-color 0.2s var(--ease);
  }

  .email:hover {
    border-bottom-color: var(--accent);
  }

  .email .arrow {
    transition: transform 0.2s var(--ease);
  }

  .email:hover .arrow {
    transform: translate(3px, -3px);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }

  .location {
    font-size: 0.85rem;
    color: var(--text-dim);
  }
</style>
