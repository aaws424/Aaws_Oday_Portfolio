---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <rect width="32" height="32" rx="8" fill="#14191e" />
  <path d="M6 22c3-1 4-6 8-7s5 3 8 2 3-5 4-6" fill="none" stroke="#ff7a3d" stroke-width="2" stroke-linecap="round" />
  <path d="M6 26c3-1 5-4 9-4.5s6 2 11 0" fill="none" stroke="#ff7a3d" stroke-opacity=".45" stroke-width="1.5" stroke-linecap="round" />
  <path d="M8 13c2-2 3.5-4.5 6.5-4.5S19 11 24 8" fill="none" stroke="#a0a9b5" stroke-opacity=".5" stroke-width="1.5" stroke-linecap="round" />
</svg>
