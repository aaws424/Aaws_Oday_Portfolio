---
import { site } from '../data/site';
import { withBase } from '../lib/url';
import presets from '../data/terrain-presets.json';

const first = presets[0];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <canvas class="hero-canvas" data-terrain aria-label="3D terrain generated by Terrain Engine, my terrain add-on for Blender"
  ></canvas>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{site.role} · Tools Developer</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="lede">
        I build procedural systems and production tools — Blender add-ons in Python, GPU compute shaders and C++
        geometry backends that take the repetitive work out of 3D production.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={withBase('/#work')}>View work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={withBase('/#contact')}>Get in touch</a>
      </div>
    </div>

    <aside class="viewer" data-viewer aria-label="Terrain Engine viewer">
      <div class="viewer-head">
        <p class="viewer-title"><span class="dot" aria-hidden="true"></span>Terrain Engine output</p>
        <a href={withBase('/projects/terrain-engine/')}>About the tool <span aria-hidden="true">→</span></a>
      </div>

      <div class="presets" role="group" aria-label="Preset">
        {
          presets.map((p, i) => (
            <button type="button" data-preset={p.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {p.name}
            </button>
          ))
        }
      </div>

      <div class="controls">
        <div class="scrub">
          <button type="button" class="icon-btn" data-replay title="Replay the erosion">
            <span aria-hidden="true">↻</span><span class="sr-only">Replay the erosion</span>
          </button>
          <span class="scrub-label">Before</span>
          <input type="range" min="0" max="1000" value="0" step="1" data-progress aria-label="Erosion: before to after" />
          <span class="scrub-label">After</span>
        </div>
        <div class="modes" role="group" aria-label="View">
          <button type="button" data-mode="color" aria-pressed="true">Color</button>
          <button type="button" data-mode="flow" aria-pressed="false">Flow</button>
          <button type="button" data-mode="erosion" aria-pressed="false">Erosion</button>
          <button type="button" data-mode="clay" aria-pressed="false">Clay</button>
        </div>
      </div>

      <p class="stack" data-stack>
        {first.layers.map((l) => (l.sim ? <b>{l.name}</b> : <span>{l.name}</span>))}
      </p>
      <p class="meta" data-meta>
        {first.grid}² grid · generated in {first.generateSeconds.toFixed(1)} s on an RTX 3050 · drag to orbit
      </p>
    </aside>
  </div>
</section>

<script>
  import type { Preset, ViewMode } from '../scripts/terrain';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-terrain]');
  const hero = canvas?.closest<HTMLElement>('.hero');
  const panel = hero?.querySelector<HTMLElement>('[data-viewer]');

  if (canvas && hero && panel) {
    // ?still: no fade or animation (deterministic screenshots)
    if (new URLSearchParams(location.search).has('still')) hero.classList.add('is-still');
    const presetButtons = panel.querySelectorAll<HTMLButtonElement>('[data-preset]');
    const modeButtons = panel.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const slider = panel.querySelector<HTMLInputElement>('[data-progress]')!;
    const stack = panel.querySelector<HTMLElement>('[data-stack]')!;
    const meta = panel.querySelector<HTMLElement>('[data-meta]')!;
    const press = (list: NodeListOf<HTMLButtonElement>, attr: string, value: string) =>
      list.forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));

    const showPreset = (p: Preset) => {
      press(presetButtons, 'data-preset', p.key);
      stack.replaceChildren(
        ...p.layers.map((l) => {
          const el = document.createElement(l.sim ? 'b' : 'span');
          el.textContent = l.name;
          return el;
        }),
      );
      meta.textContent = `${p.grid}² grid · generated in ${p.generateSeconds.toFixed(1)} s on an RTX 3050 · drag to orbit`;
    };

    import('../scripts/terrain')
      .then(({ initTerrain, PRESETS }) => {
        const viewer = initTerrain(canvas, import.meta.env.BASE_URL, {
          onPreset: showPreset,
          onProgress: (v) => (slider.value = String(Math.round(v * 1000))),
          onLoading: (loading) => panel.classList.toggle('is-loading', loading),
        });
        presetButtons.forEach((b) => b.addEventListener('click', () => viewer.setPreset(b.dataset.preset!)));
        modeButtons.forEach((b) =>
          b.addEventListener('click', () => {
            viewer.setMode(b.dataset.mode as ViewMode);
            press(modeButtons, 'data-mode', b.dataset.mode!);
          }),
        );
        slider.addEventListener('input', () => viewer.scrub(Number(slider.value) / 1000));
        panel.querySelector('[data-replay]')!.addEventListener('click', () => {
          viewer.scrub(0);
          viewer.play();
        });
        // deep links: ?preset=island&mode=flow
        const params = new URLSearchParams(location.search);
        const mode = panel.querySelector<HTMLButtonElement>(`[data-mode="${params.get('mode')}"]`);
        mode?.click();
        const preset = PRESETS.find((p) => p.key === params.get('preset')) ?? PRESETS[0];
        return viewer.setPreset(preset.key).then(() => hero.classList.add('is-live'));
      })
      .catch((err) => {
        console.warn('Terrain viewer disabled:', err);
        hero.classList.add('no-webgl');
      });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: max(700px, 100svh);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(55% 60% at 70% 45%, #ffffff 0%, transparent 70%),
      var(--bg);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }

  .hero.is-live .hero-canvas {
    opacity: 1;
  }

  .hero.is-still .hero-canvas {
    transition: none;
  }

  .hero-canvas:global(.is-dragging) {
    cursor: grabbing;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(245, 244, 240, 0.95) 0%, rgba(245, 244, 240, 0.7) 30%, transparent 52%),
      linear-gradient(0deg, var(--bg) 0%, transparent 16%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: inherit;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 3rem;
    pointer-events: none;
  }

  .hero-inner a,
  .hero-inner button,
  .hero-inner input,
  .viewer {
    pointer-events: auto;
  }

  .hero-copy {
    max-width: 560px;
  }

  h1 {
    margin-top: 1.1rem;
    font-size: clamp(3.2rem, 8.5vw, 6.8rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 33rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* ---- viewer panel ---- */

  .viewer {
    position: absolute;
    right: var(--gutter);
    bottom: 2rem;
    width: min(560px, 46vw);
    display: grid;
    gap: 0.8rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: var(--shadow-md);
    font-size: 0.8rem;
  }

  .hero.no-webgl .viewer {
    display: none;
  }

  .viewer.is-loading {
    cursor: progress;
  }

  .viewer.is-loading .dot {
    animation-duration: 0.6s;
  }

  .viewer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .viewer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .viewer-head a {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(228, 87, 15, 0.5);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px rgba(228, 87, 15, 0);
    }
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .presets button,
  .modes button,
  .icon-btn {
    border: 1px solid var(--line-strong);
    background: #ffffff;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .presets button {
    flex: none;
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .presets button:hover,
  .modes button:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }

  .presets button[aria-pressed='true'],
  .modes button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #ffffff;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .scrub {
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .scrub-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-dim);
  }

  input[type='range'] {
    flex: 1;
    min-width: 80px;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .icon-btn {
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    font-size: 0.95rem;
  }

  .icon-btn:hover {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .modes {
    display: flex;
    padding: 2px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #ffffff;
  }

  .modes button {
    border: 0;
    background: transparent;
    padding: 0.32rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .stack :global(span),
  .stack :global(b) {
    padding: 0.18rem 0.45rem;
    border-radius: 5px;
    background: #f1efea;
    font-weight: 400;
  }

  .stack :global(b) {
    background: var(--accent-soft);
    color: var(--accent-text);
    font-weight: 500;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-dim);
  }

  /* Narrow screens: the terrain gets the top of the screen, copy and controls sit below it. */
  @media (max-width: 899px) {
    .hero {
      align-items: flex-start;
    }

    .hero-canvas {
      height: 60svh;
    }

    .hero-shade {
      background: linear-gradient(180deg, transparent 0, transparent 44svh, var(--bg) 60svh);
    }

    .hero-inner {
      justify-content: flex-start;
      padding-top: 52svh;
    }

    .viewer {
      position: static;
      width: 100%;
      max-width: 560px;
      margin-top: 2.25rem;
    }
  }
</style>
