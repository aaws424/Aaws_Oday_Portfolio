---
import { site } from '../data/site';
import { withBase } from '../lib/url';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <canvas class="hero-canvas" data-terrain aria-label="Live 3D terrain being shaped by a hydraulic erosion simulation"
  ></canvas>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{site.role} · Tools Developer</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="lede">
        I build procedural systems and production tools — Blender add-ons in Python, GPU compute shaders and C++
        geometry backends that take the repetitive work out of 3D production.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={withBase('/#work')}>View work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={withBase('/#contact')}>Get in touch</a>
      </div>
    </div>

    <aside class="hud" aria-label="Simulation controls">
      <p class="hud-title"><span class="dot" aria-hidden="true"></span> Live · droplet erosion</p>
      <p class="hud-sub">
        Ported from <a href={withBase('/projects/terrain-engine/')}>Terrain Engine</a>, my GPU terrain add-on for Blender
      </p>
      <dl>
        <div><dt>droplets</dt><dd><span data-hud="droplets">0</span> / <span data-hud="total">—</span></dd></div>
        <div><dt>grid</dt><dd data-hud="grid">—</dd></div>
        <div><dt>seed</dt><dd data-hud="seed">—</dd></div>
      </dl>
      <div class="progress" aria-hidden="true"><span data-hud="progress"></span></div>
      <div class="hud-controls">
        <div class="modes" role="group" aria-label="Data map">
          <button type="button" data-mode="shaded" aria-pressed="true">Shaded</button>
          <button type="button" data-mode="flow" aria-pressed="false">Flow</button>
          <button type="button" data-mode="wear" aria-pressed="false">Wear</button>
        </div>
        <button type="button" class="reseed" data-hud="reseed" title="Generate a new terrain">
          <span aria-hidden="true">↻</span><span class="sr-only">New terrain</span>
        </button>
      </div>
      <p class="hud-hint">Drag the terrain to orbit</p>
    </aside>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-terrain]');
  const hero = canvas?.closest<HTMLElement>('.hero');
  const $ = <T extends HTMLElement>(name: string) => hero?.querySelector<T>(`[data-hud="${name}"]`) ?? null;

  if (canvas && hero) {
    import('../scripts/terrain')
      .then(({ initTerrain }) => {
        initTerrain(canvas, {
          droplets: $('droplets'),
          total: $('total'),
          grid: $('grid'),
          seed: $('seed'),
          progress: $('progress'),
          reseed: $<HTMLButtonElement>('reseed'),
          modes: hero.querySelectorAll<HTMLButtonElement>('[data-mode]'),
        });
        hero.classList.add('is-live');
      })
      .catch((err) => {
        console.warn('Terrain hero disabled:', err);
        hero.classList.add('no-webgl');
      });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 55% at 72% 55%, rgba(255, 122, 61, 0.08), transparent 70%),
      var(--bg);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .hero.is-live .hero-canvas {
    opacity: 1;
  }

  .hero-canvas:global(.is-dragging) {
    cursor: grabbing;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(10, 12, 15, 0.92) 0%, rgba(10, 12, 15, 0.55) 34%, transparent 58%),
      linear-gradient(0deg, var(--bg) 0%, transparent 22%),
      linear-gradient(180deg, rgba(10, 12, 15, 0.6) 0%, transparent 18%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: inherit;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 3rem;
    pointer-events: none;
  }

  .hero-inner a,
  .hero-inner button {
    pointer-events: auto;
  }

  .hero-copy {
    max-width: 600px;
  }

  h1 {
    margin-top: 1.1rem;
    font-size: clamp(3.2rem, 9vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* ---- HUD ---- */

  .hud {
    position: absolute;
    right: var(--gutter);
    bottom: 2.5rem;
    width: 300px;
    padding: 1rem 1.1rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgba(12, 15, 19, 0.72);
    backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    pointer-events: auto;
  }

  .hero.no-webgl .hud {
    display: none;
  }

  .hud-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(255, 122, 61, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(255, 122, 61, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 122, 61, 0);
    }
  }

  .hud-sub {
    margin-top: 0.45rem;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .hud-sub a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 2px;
  }

  .hud-sub a:hover {
    color: var(--accent);
  }

  dl {
    margin: 0.85rem 0 0;
    display: grid;
    gap: 0.3rem;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  dt {
    color: var(--text-dim);
  }

  dd {
    margin: 0;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .progress {
    margin-top: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hud-controls {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .modes {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 3px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  .modes button,
  .reseed {
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .modes button {
    padding: 0.4rem 0;
    border-radius: 999px;
  }

  .modes button:hover {
    color: var(--text);
  }

  .modes button[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }

  .reseed {
    width: 34px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 0.95rem;
  }

  .reseed:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hud-hint {
    margin-top: 0.7rem;
    font-size: 0.66rem;
    color: var(--text-dim);
  }

  /* Narrow screens: the terrain gets the top of the screen, the copy sits below it. */
  @media (max-width: 899px) {
    .hero {
      align-items: flex-start;
    }

    .hero-canvas {
      height: 62svh;
    }

    .hero-shade {
      background:
        linear-gradient(180deg, transparent 0, transparent 40svh, var(--bg) 62svh),
        linear-gradient(180deg, rgba(10, 12, 15, 0.6) 0%, transparent 12svh);
    }

    .hero-inner {
      justify-content: flex-start;
      padding-top: 50svh;
    }

    .hud {
      position: static;
      width: 100%;
      max-width: 420px;
      margin-top: 2.5rem;
    }

    .hud-hint {
      display: none;
    }
  }
</style>
